# battery-soh runtime settings. Every variable is OPTIONAL: the defaults shown below are
# what the service uses when a variable is unset. Nothing here is a secret.
#
# How the variables are picked up:
#   soh serve / uvicorn  : export them in your shell (the SOH_* ones are read by
#                          battery_soh.api.settings through pydantic-settings).
#   docker run           : pass them with -e NAME=value.
#   docker compose       : export them in your shell, or copy this file to .env (compose
#                          reads .env for ${...} interpolation; see docker-compose.yml).

# --- application (prefix SOH_) ---------------------------------------------------------

# Application log level: DEBUG, INFO, WARNING or ERROR.
SOH_LOG_LEVEL=INFO

# true = one JSON object per log line (for log shippers); false = human-readable lines.
# docker-compose.yml defaults this to true.
SOH_LOG_JSON=false

# Origins allowed to call the API from a browser, as a JSON list, e.g.
#   SOH_CORS_ORIGINS=["https://example.org","http://localhost:5173"]
# The bundled web UI is served from the same origin and needs no CORS. Empty = no
# cross-origin access.
SOH_CORS_ORIGINS=[]

# Largest accepted request body in bytes; larger requests get 413 before parsing.
SOH_MAX_BODY_BYTES=1000000

# Most items accepted by POST /v1/soh/batch (the schema ceiling is 1000); larger batches
# get 422 before any estimate is computed.
SOH_MAX_BATCH_ITEMS=100

# Most samples per array accepted by POST /v1/soh/estimate-from-cycle.
SOH_MAX_SAMPLES=20000

# --- server process (Docker image) -----------------------------------------------------

# Port the server listens on inside the container (PaaS platforms such as Render, Fly.io
# or Heroku set it for you). With docker compose it selects the HOST port on 127.0.0.1.
PORT=8000

# Number of uvicorn worker processes. Each worker loads its own copy of the models and
# its own Prometheus registry (/metrics then reflects one worker per scrape), so prefer
# 1 per container and scale with replicas.
WEB_CONCURRENCY=1
